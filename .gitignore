# ============================================================================
# 数据与索引 —— 体积巨大，一律不入库
# ============================================================================
# data/ 合计 35 GB，包含：
#   · data/processed/chunks.parquet  331 万 chunk 语料，2.17 GB / 4 分片
#   · data/index/bge-large-zh-v1.5/  向量矩阵 emb.npy 6.79 GB
#   · data/index/faiss_ivf_flat.index  IVF 索引 13.6 GB（nprobe=512）
#   · data/index/bm25/                BM25 倒排索引（词表 192 万）
#   · data/raw/                       维基 dump 与 JSONL 中间态
# 这些全部可由源码从原始 dump 重新生成，复现步骤见 README「复现」章节。
/data/

# 模型缓存必须在项目外（本机放在 E:\AI-learning\ms-cache），防误建
/ms-cache/
/models/

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# ============================================================================
# 大体积二进制与中间产物（能重跑出来的一律不收）
# ============================================================================
*.npy
*.npz
*.parquet
*.faiss
*.index
*.bin
*.pkl
*.pt
*.safetensors
*.onnx
*.h5

# 历史基准测试的中间产物 —— 不是结论，可由脚本重跑
/eval/results/vec_bench/
/eval/results/vec_bench_b128/
/eval/results/vec_bench_small/
/eval/results/vec_smoke/
/eval/results/bm25_smoke/
/eval/results/char_len_parts/
/eval/results/vectorize_full_run*.log

# 临时 / 冒烟产物
/eval/results/eval_smoke*.json
/eval/results/_scratch/

# 接线错误时的产物留档（§11.14 的 topk 截断 bug）——
# 本地留着当反例，但不进仓库：结论已写进文档，留下 800KB 的"错答案"
# 只会让看仓库的人分不清哪份是有效的。
/eval/results/_bad/

# ============================================================================
# 编辑器 / 系统
# ============================================================================
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# ============================================================================
# 密钥（本项目的云端后端从环境变量 DASHSCOPE_API_KEY 读取，不落盘）
# ============================================================================
.env
.env.*
*.key
*.pem

# 判官缓存（派生数据，可用 --force 重跑；214 KB，不必入库）
/eval/results/faith_judge_cache.json
